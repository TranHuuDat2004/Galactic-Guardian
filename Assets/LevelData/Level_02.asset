  m_Script: {fileID: 11500000, guid: 8a74b989c66b5fd43a44635ecef7aa1c, type: 3}
  m_Name: Level_02
  m_EditorClassIdentifier: Assembly-CSharp::LevelData
  levelName: "M\xE0n 1: M\xE1y Bay X\xE2m Chi\u1EBFm"
  storyText: "Ch\u01B0\u01A1ng 2: Truy\u1EC1n tin n\u1ED9i b\u1ED9 phi \u0111\u1ED9i\n\n\nTinh
    V\u1EC7 : \"Kh\xF4ng... L\u1EA1y Ch\xFAa. Ch\xFAng... ch\xFAng \u0111\xE3 gi\u1EBFt
    t\u1EA5t c\u1EA3. T\xE1m ng\xE0n ng\u01B0\u1EDDi... B\u1ECDn ch\xFAng kh\xF4ng
    tha m\u1ED9t ai.\"\n\nTinh V\u1EC7  (Ng\u01B0\u1EDDi ch\u01A1i): \"Trung t\xE2m
    ch\u1EC9 huy, Tinh V\u1EC7  b\xE1o c\xE1o. T\xECnh h\xECnh... l\xE0 m\u1ED9t
    th\u1EA3m h\u1ECDa. X\xE1c nh\u1EADn, kh\xF4ng c\xF2n ai s\u1ED1ng s\xF3t. Ti\u1EC1n
    \u0111\u1ED3n \u0111\xE3 b\u1ECB ph\xE1 h\u1EE7y ho\xE0n to\xE0n.\"\n\n(T\u1EA1m
    d\u1EEBng. Ch\u1EC9 huy im l\u1EB7ng m\u1ED9t l\xFAc, gi\u1ECDng \xF4ng tr\u1EDF
    n\xEAn s\u1EAFt l\u1EA1nh khi n\xF3i l\u1EA1i.)\n\nCh\u1EC9 huy: \"Tinh V\u1EC7...
    T\xECm ki\u1EBFm b\u1EA5t k\u1EF3 manh m\u1ED1i n\xE0o. B\u1EA5t c\u1EE9 th\u1EE9
    g\xEC. Ai \u0111\xE3 l\xE0m vi\u1EC7c n\xE0y?\"\n\n(Ng\u01B0\u1EDDi ch\u01A1i
    \u0111i\u1EC1u khi\u1EC3n t\xE0u l\u01B0\u1EDBt qua m\u1ED9t m\u1EA3nh v\u1EE1
    kh\u1ED5ng l\u1ED3 c\u1EE7a th\xE1p ch\u1EC9 huy. Camera ph\xF3ng to v\xE0o m\u1ED9t
    v\u1EBFt ch\xE1y x\xE9m \u0111\u1EB7c tr\u01B0ng tr\xEAn v\u1ECF t\xE0u.)\n\nTinh
    V\u1EC7 : \"T\xF4i th\u1EA5y r\u1ED3i... tr\xEAn m\u1EA3nh v\u1EE1 ch\xEDnh.
    M\u1ED9t bi\u1EC3u t\u01B0\u1EE3ng... m\u1EB7t tr\u0103ng khuy\u1EBFt m\xE0u
    \u0111\u1ECF m\xE1u. \u0110\xE2y l\xE0 H\u1EA1m \u0111\u1ED9i Huy\u1EBFt Nguy\u1EC7t.\"\n\nCh\u1EC9
    huy: \"Huy\u1EBFt Nguy\u1EC7t... Ch\xFAng d\xE1m ti\u1EBFn xa \u0111\u1EBFn t\u1EADn
    V\xE0nh \u0111ai X-12 sao? Ch\xFAng kh\xF4ng bao gi\u1EDD h\xE0nh \u0111\u1ED9ng
    m\xE0 kh\xF4ng c\xF3 l\xFD do.\"\n\nS\u0129 quan Chi\u1EBFn thu\u1EADt (AI tr\xEAn
    t\xE0u): \"Phi c\xF4ng, c\u1EA3nh b\xE1o. C\u1EA3m bi\u1EBFn t\u1EA7m xa ph\xE1t
    hi\u1EC7n \u0111i\u1EC1u b\u1EA5t th\u01B0\u1EDDng. Ph\xE2n t\xEDch d\u1EEF li\u1EC7u
    t\u1EEB l\xF5i m\xE1y t\xEDnh c\u1EE7a ti\u1EC1n \u0111\u1ED3n... d\xF9 b\u1ECB
    h\u1ECFng n\u1EB7ng, n\xF3 ghi l\u1EA1i nh\u1EEFng gi\xE2y cu\u1ED1i c\xF9ng.
    Huy\u1EBFt Nguy\u1EC7t kh\xF4ng ch\u1EC9 c\u01B0\u1EDBp b\xF3c. Ch\xFAng \u0111\xE3
    s\u1EED d\u1EE5ng m\u1ED9t m\xE1y qu\xE9t c\u1ED9ng h\u01B0\u1EDFng s\xE2u tr\xEAn
    to\xE0n b\u1ED9 khu v\u1EF1c m\u1ECF.\"\n\nTinh V\u1EC7 : \"Qu\xE9t t\xECm c\xE1i
    g\xEC?\"\n\nS\u0129 quan Chi\u1EBFn thu\u1EADt: \"M\u1ED9t d\u1EA1ng n\u0103ng
    l\u01B0\u1EE3ng l\u1EA1, ch\u01B0a \u0111\u01B0\u1EE3c ph\xE2n lo\u1EA1i. T\xEDn
    hi\u1EC7u n\xE0y... n\xF3 gi\u1ED1ng nh\u01B0 m\u1ED9t 'ti\u1EBFng v\u1ECDng'
    n\u0103ng l\u01B0\u1EE3ng (energy echo). T\xEDn hi\u1EC7u qu\xE9t c\u1EE7a ch\xFAng
    v\u1EABn c\xF2n l\u01B0u l\u1EA1i m\u1EDD nh\u1EA1t trong kh\xF4ng gian. T\xF4i
    c\xF3 th\u1EC3 kh\xF3a n\xF3. Ch\xFAng \u0111ang theo \u0111u\u1ED5i th\u1EE9
    g\xEC \u0111\xF3.\"\n\nCh\u1EC9 huy: \"\u0110\xF3 l\xE0 m\u1EE5c ti\xEAu c\u1EE7a
    ch\xFAng ta. Ch\xFAng ta kh\xF4ng ch\u1EC9 tr\u1EA3 th\xF9 cho X-12, ch\xFAng
    ta c\u1EA7n ph\u1EA3i bi\u1EBFt Huy\u1EBFt Nguy\u1EC7t \u0111ang t\xECm ki\u1EBFm
    th\u1EE9 g\xEC. Tinh V\u1EC7, l\u1EA7n theo d\u1EA5u v\u1EBFt n\u0103ng l\u01B0\u1EE3ng
    \u0111\xF3! \u0110\u1EEBng \u0111\u1EC3 ch\xFAng c\xF3 \u0111\u01B0\u1EE3c th\u1EE9
    ch\xFAng mu\u1ED1n!\""
